{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amy-english-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",

  // Workers AI. Always runs remotely — even under `wrangler dev` it calls the
  // real model and draws from the daily neuron allowance.
  "ai": { "binding": "AI" },

  // The PWA ships from this same Worker, so page and API are one deploy on
  // one origin.
  //
  // public/ holds exactly what goes public — nothing else. Pointing this at
  // the repo root instead was tried and rejected: wrangler walked .git/ (190
  // files vs 35 real ones), and an .assetsignore allowlist did not stop it.
  // A dedicated directory makes "what is published" structural rather than
  // dependent on an ignore file behaving as expected.
  "assets": {
    "directory": "../public/",
    // Assets are served first for everything else; only /api/* reaches the
    // Worker script, so no static file can ever shadow the API.
    "run_worker_first": ["/api/*"]
  },

  // Same-origin routes are the primary path: the page and /api/* share
  // amyeng.top, so there is no CORS preflight — one less round trip on a
  // flaky mainland connection. The api. subdomain is the fallback for when
  // the page is served from somewhere other than this zone.
  //
  // NOTE: *.workers.dev is DNS-poisoned in the mainland. It stays available
  // for your own testing, but never point the app at it.
  "routes": [
    { "pattern": "amyeng.top/api/*", "zone_name": "amyeng.top" },
    { "pattern": "www.amyeng.top/api/*", "zone_name": "amyeng.top" },
    { "pattern": "api.amyeng.top", "custom_domain": true }
  ],

  "vars": {
    // Only consulted on the api. subdomain; same-origin requests never
    // preflight. Keep in sync with the domains the app is served from.
    "ALLOWED_ORIGIN": "https://amyeng.top"
  },

  "observability": {
    "enabled": true
  }
}
